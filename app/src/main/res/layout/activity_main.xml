<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080814">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="28dp">

        <!-- LEFT: Branding -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:text="GRIMPAD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="46sp"
                android:textStyle="bold"
                android:textColor="#10b981"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.15"/>

            <View
                android:layout_width="160dp"
                android:layout_height="2dp"
                android:background="#10b981"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:text="VIRTUAL XBOX CONTROLLER"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#2a4a3a"
                android:fontFamily="monospace"
                android:letterSpacing="0.22"/>

            <TextView
                android:text="UP TO 15 PLAYERS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="#1a3a2a"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- DIVIDER -->
        <View
            android:layout_width="1dp"
            android:layout_height="140dp"
            android:background="#1a2a20"
            android:layout_marginHorizontal="28dp"/>

        <!-- RIGHT: Controls -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- Main buttons (default visible) -->
            <LinearLayout
                android:id="@+id/mainButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical">

                <!-- Server input -->
                <TextView
                    android:text="RELAY SERVER"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9sp"
                    android:textColor="#2a4a3a"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="5dp"/>

                <EditText
                    android:id="@+id/serverInput"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="192.168.1.x:8765"
                    android:text="localhost:8765"
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:background="@drawable/input_bg"
                    android:padding="10dp"
                    android:inputType="textUri"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp"/>

                <!-- Controller type -->
                <RadioGroup
                    android:id="@+id/ctrlTypeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="18dp">
                    <RadioButton android:id="@+id/radioSeries"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="SERIES X/S"
                        android:textColor="#00c8ff" android:buttonTint="#00c8ff"
                        android:checked="true" android:textSize="10sp" android:fontFamily="monospace"/>
                    <RadioButton android:id="@+id/radio360"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="XBOX 360"
                        android:textColor="#10b981" android:buttonTint="#10b981"
                        android:textSize="10sp" android:fontFamily="monospace"/>
                </RadioGroup>

                <Button android:id="@+id/btnHost"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="HOST  —  PLAYER 1"
                    android:textSize="12sp" android:textStyle="bold"
                    android:textColor="#000000" android:backgroundTint="#10b981"
                    android:letterSpacing="0.06" android:layout_marginBottom="8dp"
                    android:fontFamily="monospace"/>

                <Button android:id="@+id/btnJoin"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="JOIN WITH CODE"
                    android:textSize="12sp" android:textStyle="bold"
                    android:textColor="#00c8ff" android:backgroundTint="#080f1a"
                    android:letterSpacing="0.06" android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- HOST CODE display (hidden by default) -->
            <LinearLayout
                android:id="@+id/hostCodeLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView android:id="@+id/codeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR ROOM CODE"
                    android:textSize="10sp"
                    android:textColor="#2a4a3a"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="12dp"/>

                <TextView android:id="@+id/codeDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="......"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:textColor="#10b981"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.3"
                    android:layout_marginBottom="8dp"/>

                <View android:layout_width="200dp" android:layout_height="2dp"
                    android:background="#10b981" android:layout_marginBottom="16dp"/>

                <TextView
                    android:text="Controller launching in 2s..."
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#1a3a2a"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="16dp"/>

                <Button android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="BACK"
                    android:textSize="10sp"
                    android:textColor="#555555"
                    android:backgroundTint="#0d0d1a"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- JOIN CODE input (hidden by default) -->
            <LinearLayout
                android:id="@+id/joinCodeLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENTER ROOM CODE"
                    android:textSize="10sp"
                    android:textColor="#2a4a3a"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="12dp"/>

                <EditText android:id="@+id/codeInput"
                    android:layout_width="200dp"
                    android:layout_height="60dp"
                    android:hint="000000"
                    android:textSize="32sp"
                    android:textColor="#10b981"
                    android:textStyle="bold"
                    android:background="@drawable/input_bg"
                    android:padding="10dp"
                    android:inputType="number"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:maxLength="6"
                    android:layout_marginBottom="16dp"/>

                <Button android:id="@+id/btnJoinConfirm"
                    android:layout_width="200dp"
                    android:layout_height="48dp"
                    android:text="CONNECT"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:backgroundTint="#10b981"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="10dp"/>

                <Button android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="BACK"
                    android:textSize="10sp"
                    android:textColor="#555555"
                    android:backgroundTint="#0d0d1a"
                    android:fontFamily="monospace"/>
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

    <TextView
        android:text="v1.0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:textSize="9sp"
        android:textColor="#0d1a10"
        android:fontFamily="monospace"
        android:padding="12dp"/>
</FrameLayout>
